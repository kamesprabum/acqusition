# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy to .env.development for local work or .env.production for production
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Development with Neon Local (Docker) ---
# NEON_API_KEY=your_neon_api_key_here
# NEON_PROJECT_ID=your_neon_project_id_here
# PARENT_BRANCH_ID=main
# DATABASE_URL=postgres://neon:npg@neon-local:5432/acqusition?sslmode=require
# (Or on host machine: postgres://neon:npg@localhost:5432/acqusition?sslmode=require)

# --- Production with Neon Cloud Database ---
# DATABASE_URL=postgres://<user>:<password>@<endpoint-id>.<region>.aws.neon.tech/<dbname>?sslmode=require

DATABASE_URL=

# Arcjet Key
ARCJET_KEY=