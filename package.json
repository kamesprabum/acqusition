{
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "winston": "^3.19.0"
  },
  "name": "acqusition",
  "version": "1.0.0",
  "description": "A hands-on DevOps learning repository where I build and improve a real API while practicing infrastructure, automation, and deployment workflows.",
  "main": "index.js",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9"
  },
  "imports": {

  
  "#controllers/*": "./src/controllers/*",
  "#config/*": "./src/config/*",
  "#routes/*": "./src/routes/*",
  "#services/*": "./src/services/*",
  "#models/*": "./src/models/*",
  "#utils/*": "./src/util/*",
  "#validations/*": "./src/validations/*"

    
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "lint": "eslint . ",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamesprabum/acqusition.git"
  },
  "keywords": [],
